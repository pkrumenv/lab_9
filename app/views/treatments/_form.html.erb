<%= form_with(model: [@appointment, treatment]) do |f| %>
  <%= render "shared/error_messages", object: f.object %>

  <div class="mb-3">
    <%= f.label :name, "Treatment Name", class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :medication, "Medication", class: "form-label" %>
    <%= f.text_field :medication, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :dosage, "Dosage", class: "form-label" %>
    <%= f.text_field :dosage, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :administered_at, "Administered At", class: "form-label" %>
    <%= f.datetime_field :administered_at, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :clinical_notes, "Clinical Notes", style: "display: block", class: "form-label" %>
    <%= f.rich_text_area :clinical_notes, class: "form-control" %>
  </div>


  <div class="mt-4">
    <%= f.submit "Save Treatment", class: "btn btn-success" %>
  </div>
<% end %>