<div class="mb-4">
  <h1>Appointments</h1>

  <% if policy(Appointment).new? %>
    <%= link_to 'New Appointment', new_appointment_path, class: "btn btn-primary" %>
  <% end %>
  
</div>
<table class="table table-striped table-hover shadow-sm">
  <thead class="table-dark">
    <tr>
      <th>Date</th>
      <th>Pet Name</th>
      <th>Vet Name</th>
      <th>Reason</th>
      <th>Status</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @appointments.each do |appointment| %>
      <tr>
        <td class="fw-bold"><%= appointment.date.strftime("%B %d, %Y") %></td>
        <td><%= appointment.pet.name %></td>
        <td><%= appointment.vet.name %></td>
        <td><%= appointment.reason %></td>
        <td>
          <span class="badge <%= appointment.status == 'completed' ? 'bg-success' : 'bg-warning text-dark' %>">
            <%= appointment.status.to_s.humanize %>
          </span>
        </td>
        <td>
          <% if policy(appointment).show? %>
            <%= link_to "View Details", appointment_path(appointment), class: "btn btn-sm btn-outline-primary" %>
          <% end %>
          </td>
      </tr>
    <% end %>
  </tbody>
</table>