<div class="card mb-4 shadow-sm border-primary">
  <div class="card-header bg-primary text-white">
    <h2 class="mb-0">Appointment Details</h2>
  </div>
  <div class="card-body">
    <div class="row mb-3">
      <div class="col-md-4">
        <strong>Date:</strong><br>
        <%= @appointment.date.strftime("%B %d, %Y") %>
      </div>
      <div class="col-md-4">
        <strong>Pet:</strong><br>
        <%= link_to @appointment.pet.name, pet_path(@appointment.pet) %>
      </div>
      <div class="col-md-4">
        <strong>Veterinarian:</strong><br>
        <%= link_to @appointment.vet.name, vet_path(@appointment.vet) %>
      </div>
    </div>
    <div class="row">
      <div class="col-md-8">
        <strong>Reason for visit:</strong><br>
        <%= @appointment.reason %>
      </div>
      <div class="col-md-4">
        <strong>Status:</strong><br>
        <span class="badge bg-primary fs-6"><%= @appointment.status.titleize %></span>
      </div>
    </div>
  </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0">Treatments Administered</h3>
  <% if policy(Treatment.new(appointment: @appointment)).new? %>
    <%= link_to 'New Treatment', new_appointment_treatment_path(@appointment), class: "btn btn-success" %>
  <% end %>
</div>

<div class="table-responsive">
  <table class="table table-bordered align-middle">
    <thead class="table-light">
      <tr>
        <th>Treatment Name</th>
        <th>Medication</th>
        <th>Dosage</th>
        <th>Administered At</th>
        <th>Notes</th>
        <th>Actions</th> 
      </tr>
    </thead>
    <tbody>
      <% @treatments.each do |treatment| %>
        <% if treatment.persisted? %>
          <tr>
            <td class="fw-bold"><%= treatment.name %></td>
            <td><%= treatment.medication %></td>
            <td><%= treatment.dosage %></td>
            <td><%= treatment.administered_at.strftime("%I:%M %p") %></td>
            
            <td><%= treatment.clinical_notes %></td>
            
            <td>
              <div class="d-flex gap-2">
                <% if policy(treatment).edit? %>
                  <%= link_to 'Edit', edit_appointment_treatment_path(@appointment, treatment), class: "btn btn-sm btn-outline-primary" %>
                <% end %>
                <% if policy(treatment).destroy? %>
                  <%= button_to 'Delete', appointment_treatment_path(@appointment, treatment), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-outline-danger" %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      <% end %>
      
      <% if @treatments.empty? %>
        <tr>
          <td colspan="6" class="text-center text-muted fst-italic">No treatments recorded for this appointment.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>



<div class="d-flex gap-2 mt-4">
  <% if policy(@appointment).edit? %>
    <%= link_to 'Edit Appointment', edit_appointment_path(@appointment), class: "btn btn-warning" %>
  <% end %>
  <% if policy(@appointment).destroy? %>
    <%= button_to 'Delete Appointment', appointment_path(@appointment), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-danger" %>
  <% end %>
    <%= link_to 'Back to Appointments', appointments_path, class: "btn btn-secondary" %>
</div>