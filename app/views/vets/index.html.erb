<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Our Veterinarians</h1>
  <% if policy(Vet).new? %>
    <%= link_to 'Add New Vet', new_vet_path, class: "btn btn-primary" %>
  <% end %>
  </div>

<div class="row">
  <% @vets.each do |vet| %>
    <div class="col-md-4 mb-4">
      <div class="card h-100 shadow-sm">
        <div class="card-body">
          <h5 class="card-title">Dr. <%= vet.first_name %> <%= vet.last_name %></h5>
          <h6 class="card-subtitle mb-2 text-muted"><%= vet.specialization %></h6>
          <p class="card-text"><i class="bi bi-envelope"></i> <%= vet.email %></p>
          
          <div class="mt-3 d-flex gap-1">
            <% if policy(vet).show? %>
              <%= link_to 'Details', vet, class: "btn btn-sm btn-outline-info" %>
            <% end %>
            <% if policy(vet).edit? %>
              <%= link_to 'Edit', edit_vet_path(vet), class: "btn btn-sm btn-outline-warning" %>
            <% end %>
            <% if policy(vet).destroy? %>
              <%= button_to 'Remove', vet, method: :delete, data: { turbo_confirm: "Remove doctor?" }, class: "btn btn-sm btn-outline-danger" %>
            <% end %>
            </div>
        </div>
      </div>
    </div>
  <% end %>
</div>