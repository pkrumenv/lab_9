<div class="card mb-4 shadow-sm border-warning">
  <div class="card-header bg-warning text-dark text-center">
    <h2 class="mb-0">Veterinarian Profile</h2>
  </div>
  <div class="card-body text-center">
    <h3 class="display-6">Dr. <%= @vet.first_name %> <%= @vet.last_name %></h3>
    <p class="badge bg-dark fs-5"><%= @vet.specialization %></p>
    <hr>
    <p><strong>Contact Email:</strong> <%= @vet.email %></p>
    <p><strong>Phone:</strong> <%= @vet.phone %></p>
  </div>
</div>

<div class="d-flex justify-content-center gap-2">
  <% if policy(@vet).edit? %>
    <%= link_to 'Edit Profile', edit_vet_path(@vet), class: "btn btn-warning" %>
  <% end %>
  <% if policy(@vet).destroy? %>
    <%= button_to 'Delete Profile', @vet, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-danger" %>
  <% end %>
  <%= link_to 'Back to Vets', vets_path, class: "btn btn-secondary" %>
</div>