<div class="card mb-4 shadow-sm border-success">
  <div class="card-header bg-success text-white">
    <h2 class="mb-0"><%= @pet.name %></h2>
  </div>
  <div class="card-body">
    <div class="row">
      <div class="col-md-6">
        <p><strong>Species:</strong> <%= @pet.species %></p>
        <p><strong>Breed:</strong> <%= @pet.breed %></p>
        <p><strong>Weight:</strong> <%= @pet.weight %> kg</p>
      </div>
      <div class="col-md-6">
        <p><strong>Owner:</strong> <%= link_to @pet.owner.first_name, @pet.owner %></p>
        <p><strong>Birthday:</strong> <%= @pet.date_of_birth %></p>
      </div>
    </div>
  </div>
</div>

<div class="text-center mb-4">
  <% if @pet.photo.attached? %>
    <%= image_tag @pet.photo, class: "img-fluid rounded shadow", style: "max-width: 300px;" %>
  <% else %>
    <div class="bg-light d-inline-flex align-items-center justify-content-center rounded border" style="width: 300px; height: 200px;">
      <span class="text-muted">No hay foto disponible</span>
    </div>
  <% end %>
</div>

<h3>Appointment History</h3>
<div class="table-responsive mb-4">
  <table class="table table-sm">
    <thead>
      <tr>
        <th>Date</th>
        <th>Reason</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% @pet.appointments.each do |app| %>
        <tr>
          <td><%= link_to app.date.strftime("%F"), app %></td>
          <td><%= app.reason %></td>
          <td><span class="badge bg-secondary"><%= app.status %></span></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="d-flex gap-2">
  <% if policy(@pet).edit? %>
    <%= link_to 'Edit Pet', edit_pet_path(@pet), class: "btn btn-warning" %>
  <% end %>
  <% if policy(@pet).destroy? %>
    <%= button_to 'Delete Pet', @pet, method: :delete, data: { turbo_confirm: "Delete this pet history?" }, class: "btn btn-danger" %>
  <% end %>
  <%= link_to 'Back to Pets', pets_path, class: "btn btn-secondary" %>
</div>