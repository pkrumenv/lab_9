<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Pets</h1>
  <% if policy(Pet).new? %>
    <%= link_to 'Register New Pet', new_pet_path, class: "btn btn-primary" %>
  <% end %>
</div>

<table class="table table-hover">
  <thead class="table-dark">
    <tr>
      <th>Photo</th>
      <th>Name</th>
      <th>Species</th>
      <th>Owner</th>
      <th class="text-center">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @pets.each do |pet| %>
      <tr>
        <td>
          <% if pet.photo.attached? %>
            <%= image_tag pet.photo.variant(resize_to_fill: [60, 60]), class: "rounded-circle border" %>
          <% else %>
            <div class="bg-light rounded-circle border d-inline-block" style="width: 60px; height: 60px;"></div>
          <% end %>
        </td>
        <td class="fw-bold"><%= pet.name %></td>
        <td><%= pet.species %></td>
        <td><%= pet.owner.last_name %></td>
        <td class="text-center">
          <div class="d-flex justify-content-center gap-2">
            <% if policy(pet).show? %>
              <%= link_to 'Show', pet, class: "btn btn-sm btn-info" %>
            <% end %>
            <% if policy(pet).edit? %>
              <%= link_to 'Edit', edit_pet_path(pet), class: "btn btn-sm btn-warning" %>
            <% end %>
            <% if policy(pet).destroy? %>
              <%= button_to 'Delete', pet, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
            <% end %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>