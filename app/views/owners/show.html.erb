<div class="card mb-4 shadow-sm border-info">
  <div class="card-header bg-info text-white">
    <h2 class="mb-0">Owner Profile</h2>
  </div>
  <div class="card-body">
    <p><strong>Name:</strong> <%= @owner.first_name %> <%= @owner.last_name %></p>
    <p><strong>Email:</strong> <%= @owner.email %></p>
    <p><strong>Phone:</strong> <%= @owner.phone %></p>
  </div>
</div>

<h3>Registered Pets</h3>
<div class="list-group mb-4">
  <% if @owner.pets.any? %>
    <% @owner.pets.each do |pet| %>
      <%= link_to pet.name, pet, class: "list-group-item list-group-item-action" %>
    <% end %>
  <% else %>
    <p class="text-muted">This owner has no pets registered.</p>
  <% end %>
</div>

<div class="d-flex gap-2">
  <% if policy(@owner).edit? %>
    <%= link_to 'Edit', edit_owner_path(@owner), class: "btn btn-warning" %>
  <% end %>
  <% if policy(@owner).destroy? %>
    <%= button_to 'Delete Owner', @owner, method: :delete, data: { turbo_confirm: "Warning: This will also delete their pets. Continue?" }, class: "btn btn-danger" %>
  <% end %>
  <%= link_to 'Back to List', owners_path, class: "btn btn-secondary" %>
</div>